---
import '../styles/global.css';
import { HTML_LANG, OG_LOCALE, alternatePath } from '../i18n/routing';
import type { Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: Locale;
}

const {
  title = 'Portfolio',
  description = 'Software engineer portfolio',
  ogImage,
  lang = 'pt-BR',
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const umamiWebsiteId = import.meta.env.UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.UMAMI_SRC;

// Preview/social card. Defaults to /preview.png (resolved to an absolute URL —
// Open Graph/Twitter require absolute URLs). Pages can override via `ogImage`.
const resolvedOgImage = Astro.site
  ? new URL(ogImage ?? '/preview.png', Astro.site).href
  : (ogImage ?? '/preview.png');

// hreflang alternates (PT na raiz, EN em /en/)
const ptHref = Astro.site
  ? new URL(alternatePath(Astro.url.pathname, 'pt-BR'), Astro.site).href
  : null;
const enHref = Astro.site
  ? new URL(alternatePath(Astro.url.pathname, 'en'), Astro.site).href
  : null;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- hreflang -->
    {ptHref && <link rel="alternate" hreflang="pt-BR" href={ptHref} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {ptHref && <link rel="alternate" hreflang="x-default" href={ptHref} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1206" />
    <meta property="og:image:height" content="672" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Detecção de idioma + preferência manual.
         Roda antes do render pra evitar flash. Regras:
         1. Preferência manual salva (localStorage.lang) sempre manda.
         2. Senão, só na 1ª visita: navegador não-PT em rota PT → /en/. -->
    <script is:inline>
      (function () {
        try {
          var path = location.pathname;
          var isEN = path === '/en' || path.indexOf('/en/') === 0;
          var current = isEN ? 'en' : 'pt-BR';

          function canonical() {
            if (path === '/en') return '/';
            if (path.indexOf('/en/') === 0) return path.slice(3);
            return path;
          }
          function toLocale(p, lang) {
            var c = canonical();
            if (lang === 'pt-BR') return c;
            return c === '/' ? '/en' : '/en' + c;
          }

          var pref = localStorage.getItem('lang');
          if (pref === 'pt-BR' || pref === 'en') {
            if (pref !== current) {
              location.replace(toLocale(path, pref) + location.search + location.hash);
            }
            return;
          }

          if (!localStorage.getItem('i18n.detected')) {
            localStorage.setItem('i18n.detected', '1');
            var nav = (navigator.language || 'pt').toLowerCase();
            if (nav.indexOf('pt') !== 0 && !isEN) {
              location.replace(toLocale(path, 'en') + location.search + location.hash);
            }
          }
        } catch (e) {}
      })();
    </script>

    <!-- Fonts: Space Grotesk + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Inter:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Reveal on scroll (utilitário global: data-reveal / data-parallax) -->
    <style is:global>
      [data-reveal] {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: var(--d, 0ms);
      }
      [data-reveal="left"]  { transform: translateX(-24px); }
      [data-reveal="right"] { transform: translateX(24px); }
      [data-reveal].in-view { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] { opacity: 1; transform: none; transition: none; }
      }
    </style>

    <!-- Umami Analytics -->
    {umamiWebsiteId && umamiSrc && (
      <script is:inline defer src={umamiSrc} data-website-id={umamiWebsiteId}></script>
    )}
  </head>
  <body class="min-h-screen">
    <slot />

    <script>
      // ── Reveal ao entrar na viewport + parallax leve (global) ──
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce) {
        revealEls.forEach((el) => el.classList.add("in-view"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in-view");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      if (!reduce) {
        const layers = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]"));
        if (layers.length) {
          let raf = 0;
          const apply = () => {
            const y = window.scrollY;
            for (const el of layers) {
              const speed = parseFloat(el.dataset.parallax || "0.1");
              el.style.transform = `translate3d(0, ${y * speed}px, 0)`;
            }
            raf = 0;
          };
          window.addEventListener(
            "scroll",
            () => { if (!raf) raf = requestAnimationFrame(apply); },
            { passive: true }
          );
          apply();
        }
      }
    </script>

    <!-- Registro de acesso → /api/track → Directus (page_views).
         sendBeacon não bloqueia a navegação; ignora localhost. -->
    <script is:inline>
      (function () {
        try {
          if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;
          var payload = JSON.stringify({
            path: location.pathname + location.search,
            referrer: document.referrer || null,
            lang: document.documentElement.lang || null,
            screen: window.screen ? window.screen.width + 'x' + window.screen.height : null,
          });
          var sent = false;
          if (navigator.sendBeacon) {
            sent = navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
          }
          if (!sent) {
            fetch('/api/track', {
              method: 'POST',
              body: payload,
              headers: { 'Content-Type': 'application/json' },
              keepalive: true,
            }).catch(function () {});
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
