---
import Footer from "../layout/Footer.astro";
import Header from "../layout/Header.astro";
import ProjectCardHorizontal from "../ui/ProjectCardHorizontal.astro";
import TechOrb from "../ui/TechOrb.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects, getExperiences, getSiteSettings, assetUrl } from "../../lib/directus";
import { formatPeriod, sortExperiences } from "../../lib/utils";
import { t, type Locale } from "../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [settings, projects, experiences] = await Promise.all([
  getSiteSettings(lang).catch((e) => {
    console.error("[HomePage] getSiteSettings failed:", e?.message ?? e);
    return null;
  }),
  getProjects(lang).catch((e) => {
    console.error("[HomePage] getProjects failed:", e?.message ?? e);
    return [];
  }),
  getExperiences(lang).catch((e) => {
    console.error("[HomePage] getExperiences failed:", e?.message ?? e);
    return [];
  }),
]);

const sortedExperiences = sortExperiences(experiences);
const clientProjects   = projects.filter(p => !p.project_type || p.project_type === 'client');
const personalProjects = projects.filter(p => p.project_type === 'personal');
const avatarUrl = assetUrl(settings?.avatar);
const avatarFocal = settings?.avatarFocal
  ? `object-position: ${settings.avatarFocal.x}% ${settings.avatarFocal.y}%`
  : undefined;

---

<BaseLayout title="Portfolio — Software Engineer" description={settings?.role} lang={lang}>
  <Header lang={lang} />

  <main>
    <!-- Glow verde que segue o cursor (mesma "sombra" da esfera) -->
    <div
      id="cursor-glow"
      class="pointer-events-none fixed top-0 left-0 z-40 w-72 h-72 rounded-full opacity-0 transition-opacity duration-300 blur-2xl"
      style="background: radial-gradient(circle, rgba(69,223,164,0.22), rgba(69,223,164,0.06) 45%, transparent 70%); mix-blend-mode: screen; will-change: transform;"
      aria-hidden="true"
    ></div>

    <!-- ── HERO + SOBRE (unificado) ────────────────── -->
    <section
      id="sobre"
      class="min-h-screen flex flex-col justify-center relative overflow-hidden pt-16"
    >
      <!-- Grid background -->
      <div
        class="absolute inset-0 opacity-[0.04]"
        style="background-image: linear-gradient(#45dfa4 1px, transparent 1px), linear-gradient(90deg, #45dfa4 1px, transparent 1px); background-size: 80px 80px;"
      />
      <!-- Accent glow -->
      <div
        class="absolute top-1/4 left-1/3 w-96 h-96 rounded-full opacity-10 blur-[120px]"
        style="background: radial-gradient(circle, #45dfa4, transparent);"
      />

      <!-- Órbita atrás do texto (só no mobile, opacidade baixa) -->
      <div
        class="lg:hidden absolute inset-0 z-0 flex items-center justify-center pointer-events-none opacity-30"
        aria-hidden="true"
      >
        <TechOrb class="w-72 h-72 sm:w-80 sm:h-80" />
      </div>

      <div class="max-w-7xl mx-auto px-6 py-28 relative z-10 w-full grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <!-- ── ESQUERDA: identidade ── -->
        <div>
          <!-- Foto circular à esquerda do nome (revelada após o typing) -->
          <div class="flex items-center mb-5">
            <div
              id="hero-photo"
              class="shrink-0 w-20 h-20 sm:w-28 sm:h-28 lg:w-32 lg:h-32 rounded-full overflow-hidden ring-1 ring-outline-variant/40 bg-surface-low origin-left"
            >
              {avatarUrl ? (
                <img
                  src={avatarUrl}
                  alt={settings?.name ?? "Profile photo"}
                  width="400"
                  height="400"
                  class="w-full h-full object-cover"
                  style={avatarFocal}
                />
              ) : (
                <svg viewBox="0 0 160 160" class="w-full h-full text-outline" aria-hidden="true">
                  <rect width="160" height="160" class="fill-surface-container" />
                  <circle cx="80" cy="62" r="28" fill="currentColor" />
                  <path d="M28 148c0-28.7 23.3-52 52-52s52 23.3 52 52" fill="currentColor" />
                </svg>
              )}
            </div>

            <h1
              class="font-display font-bold leading-none tracking-tight"
              style="font-size: clamp(2.5rem, 5vw, 4.25rem);"
            >
              <span class="block text-on-surface" aria-label="Thales">
                <span id="typing-first"></span><span id="typing-cursor">|</span>
              </span>
              <span class="block text-primary" aria-label="Santana">
                <span id="typing-second"></span>
              </span>
            </h1>
          </div>

          <p class="font-display text-lg sm:text-xl font-medium text-on-surface-variant mb-6">
            {settings?.role}
          </p>

          <p class="text-on-surface-variant leading-relaxed max-w-xl mb-10">
            {settings?.bio || t(lang, "about.bioFallback")}
          </p>

          <div class="flex flex-wrap items-center gap-4">
            <a
              href="#projetos"
              class="inline-flex items-center gap-3 px-6 py-3 font-medium text-sm text-on-primary hover:opacity-90 transition-opacity"
              style="background: linear-gradient(135deg, #45dfa4, #006041);"
            >
              {t(lang, "home.cta.projects")}
              <span class="font-mono">↓</span>
            </a>
            <a
              href="#contato"
              class="inline-flex items-center gap-3 px-6 py-3 font-medium text-sm text-on-surface border border-outline-variant/40 hover:border-primary/50 hover:text-primary transition-colors"
            >
              {t(lang, "home.cta.contact")}
            </a>
          </div>
        </div>

        <!-- ── DIREITA: órbita de tecnologias ── -->
        <div class="relative hidden lg:flex items-center justify-center min-h-120">
          <TechOrb />
        </div>
      </div>
    </section>

    <!-- ── EXPERIÊNCIAS ───────────────────────────── -->
    <section id="experiencias" class="bg-surface-low py-32">
      <div class="max-w-7xl mx-auto px-6">
        <p class="text-xs font-mono text-primary tracking-[0.3em] uppercase mb-4">
          {t(lang, "about.career.eyebrow")}
        </p>
        <h2 class="font-display text-4xl font-bold text-on-surface mb-16">
          {t(lang, "about.career.title")}
        </h2>

        {sortedExperiences.length > 0 ? (
          <>
            {/* ── DESKTOP: centro + esquerda + direita ─────────── */}
            <div class="tl-root hidden lg:block relative">
              {/* Track (linha de fundo, dim) */}
              <div
                class="tl-track absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-px"
                style="background:rgba(63,73,68,0.4)"
              />
              {/* Fill (cresce com o scroll) */}
              <div
                class="tl-fill absolute left-1/2 -translate-x-1/2 top-0 w-px origin-top pointer-events-none"
                style="height:0px;background:rgba(69,223,164,0.55)"
              />
              {/* Glowing dot */}
              <div
                class="tl-dot absolute left-1/2 pointer-events-none"
                style="top:0px;transform:translate(-50%,-50%);width:10px;height:10px;border-radius:50%;background:#45dfa4;box-shadow:0 0 12px 4px rgba(69,223,164,0.45)"
              />

              <div class="space-y-20">
                {sortedExperiences.map((exp) => (
                  <div class="grid items-start" style="grid-template-columns:1fr 40px 1fr">
                    {/* Left — period + company */}
                    <div class="pr-12 text-right">
                      <p class="text-xs font-mono text-outline tracking-wider mb-2">
                        {formatPeriod(exp.start_date, exp.end_date, exp.current, lang)}
                      </p>
                      {exp.company_url ? (
                        <a
                          href={exp.company_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-sm text-primary font-mono hover:text-[#68fcbf] transition-colors"
                        >
                          {exp.company || t(lang, "about.career.freelancer")} →
                        </a>
                      ) : (
                        <p class="text-sm text-primary font-mono">
                          {exp.company || t(lang, "about.career.freelancer")}
                        </p>
                      )}
                    </div>

                    {/* Center — hollow circle that fills on scroll */}
                    <div class="flex justify-center pt-1">
                      <div class="tl-node w-3.5 h-3.5 rounded-full border-2 border-primary/40 bg-surface-low shrink-0 transition-all duration-300" />
                    </div>

                    {/* Right — role + description */}
                    <div class="pl-12">
                      <h3 class="font-display text-xl font-semibold text-on-surface mb-3">
                        {exp.role}
                      </h3>
                      {exp.description && (
                        <p class="text-on-surface-variant leading-relaxed text-sm">
                          {exp.description}
                        </p>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* ── MOBILE: mesma animação da desktop, linha à esquerda ── */}
            <div class="tl-root lg:hidden relative">
              {/* Track */}
              <div
                class="tl-track absolute left-0 top-0 bottom-0 w-px"
                style="background:rgba(63,73,68,0.4)"
              />
              {/* Fill */}
              <div
                class="tl-fill absolute left-0 top-0 w-px origin-top pointer-events-none"
                style="height:0px;background:rgba(69,223,164,0.55)"
              />
              {/* Glowing dot */}
              <div
                class="tl-dot absolute left-0 pointer-events-none"
                style="top:0px;transform:translate(-50%,-50%);width:10px;height:10px;border-radius:50%;background:#45dfa4;box-shadow:0 0 12px 4px rgba(69,223,164,0.45)"
              />
              <div class="space-y-16">
                {sortedExperiences.map((exp) => (
                  <div class="pl-8 relative">
                    <div
                      class="tl-node absolute left-0 top-1.5 w-3.5 h-3.5 rounded-full border-2 border-primary/40 bg-surface-low transition-all duration-300"
                      style="transform:translateX(-50%)"
                    />
                    <p class="text-xs font-mono text-outline tracking-wider mb-1">
                      {formatPeriod(exp.start_date, exp.end_date, exp.current, lang)}
                    </p>
                    <h3 class="font-display text-xl font-semibold text-on-surface mb-1">{exp.role}</h3>
                    {exp.company_url ? (
                      <a
                        href={exp.company_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block text-sm text-primary font-mono mb-3 hover:text-[#68fcbf] transition-colors"
                      >
                        {exp.company || t(lang, "about.career.freelancer")} →
                      </a>
                    ) : (
                      <p class="text-sm text-primary font-mono mb-3">
                        {exp.company || t(lang, "about.career.freelancer")}
                      </p>
                    )}
                    {exp.description && (
                      <p class="text-on-surface-variant leading-relaxed text-sm">{exp.description}</p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </>
        ) : (
          <p class="text-outline font-mono text-sm">{t(lang, "about.career.empty")}</p>
        )}
      </div>
    </section>

    <!-- ── PROJETOS ───────────────────────────────── -->
    <section id="projetos" class="py-32">
      <div class="max-w-7xl mx-auto px-6">
        <div class="mb-16">
          <p class="text-xs font-mono text-primary tracking-[0.3em] uppercase mb-4">
            {t(lang, "projects.eyebrow")}
          </p>
          <h2 class="font-display text-4xl font-bold text-on-surface mb-6">
            {t(lang, "projects.title")}
          </h2>
          <p class="text-on-surface-variant max-w-xl">
            {t(lang, "projects.intro")}
          </p>
        </div>

        {clientProjects.length > 0 ? (
          <div class="flex flex-col gap-px bg-outline-variant/20">
            {clientProjects.map((project) => (
              <ProjectCardHorizontal project={project} lang={lang} />
            ))}
          </div>
        ) : (
          <div class="text-center py-32">
            <p class="text-xs font-mono text-outline tracking-widest uppercase mb-4">
              {t(lang, "projects.empty.title")}
            </p>
            <p class="text-on-surface-variant">{t(lang, "projects.empty.body")}</p>
          </div>
        )}
      </div>
    </section>

    <!-- ── DEMOS, PESSOAIS & HACKATHONS ─────────────── -->
    {personalProjects.length > 0 && (
      <section id="hackathons" class="bg-surface-low py-32">
        <div class="max-w-7xl mx-auto px-6">
          <div class="mb-16">
            <p class="text-xs font-mono text-primary tracking-[0.3em] uppercase mb-4">
              {t(lang, "personal.eyebrow")}
            </p>
            <h2 class="font-display text-4xl font-bold text-on-surface mb-6">
              {t(lang, "personal.title")}
            </h2>
            <p class="text-on-surface-variant max-w-xl">
              {t(lang, "personal.intro")}
            </p>
          </div>
          <div class="flex flex-col gap-px bg-outline-variant/20">
            {personalProjects.map((project) => (
              <ProjectCardHorizontal project={project} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── CONTATO ────────────────────────────────── -->
    <section id="contato" class="py-32" style="background:#0c1322;">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
          <!-- Left: copy -->
          <div class="lg:pt-2">
            <p class="text-xs font-mono text-primary tracking-[0.3em] uppercase mb-4">
              {t(lang, "contact.eyebrow")}
            </p>
            <h2 class="font-display text-4xl font-bold text-on-surface mb-6">
              {t(lang, "about.contact.title")}
            </h2>
            <p class="text-on-surface-variant leading-relaxed mb-8">
              {t(lang, "about.contact.body")}
            </p>
            {settings?.email && (
              <a
                href={`mailto:${settings.email}`}
                class="inline-flex items-center gap-2 text-sm font-mono text-outline hover:text-primary transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                {settings.email}
              </a>
            )}
          </div>

          <!-- Right: form -->
          <form id="contact-form" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <!-- Nome -->
              <div>
                <label for="cf-name" class="block text-xs font-mono text-outline tracking-widest uppercase mb-2">
                  {t(lang, "contact.form.name")} <span class="text-primary">*</span>
                </label>
                <input
                  id="cf-name" name="name" type="text" required
                  placeholder={t(lang, "contact.form.namePlaceholder")}
                  class="w-full bg-surface-low border border-outline-variant/40 text-on-surface text-sm font-mono px-4 py-3 outline-none focus:border-primary/60 transition-colors placeholder:text-outline/40"
                />
              </div>
              <!-- Email -->
              <div>
                <label for="cf-email" class="block text-xs font-mono text-outline tracking-widest uppercase mb-2">
                  {t(lang, "contact.form.email")} <span class="text-primary">*</span>
                </label>
                <input
                  id="cf-email" name="email" type="email" required
                  placeholder={t(lang, "contact.form.emailPlaceholder")}
                  class="w-full bg-surface-low border border-outline-variant/40 text-on-surface text-sm font-mono px-4 py-3 outline-none focus:border-primary/60 transition-colors placeholder:text-outline/40"
                />
              </div>
              <!-- Telefone -->
              <div>
                <label for="cf-phone" class="block text-xs font-mono text-outline tracking-widest uppercase mb-2">
                  {t(lang, "contact.form.phone")}
                  <span class="text-outline/50 normal-case tracking-normal ml-1">({t(lang, "contact.form.optional")})</span>
                </label>
                <input
                  id="cf-phone" name="phone" type="tel"
                  placeholder={t(lang, "contact.form.phonePlaceholder")}
                  class="w-full bg-surface-low border border-outline-variant/40 text-on-surface text-sm font-mono px-4 py-3 outline-none focus:border-primary/60 transition-colors placeholder:text-outline/40"
                />
              </div>
              <!-- Empresa -->
              <div>
                <label for="cf-company" class="block text-xs font-mono text-outline tracking-widest uppercase mb-2">
                  {t(lang, "contact.form.company")}
                  <span class="text-outline/50 normal-case tracking-normal ml-1">({t(lang, "contact.form.optional")})</span>
                </label>
                <input
                  id="cf-company" name="company" type="text"
                  placeholder={t(lang, "contact.form.companyPlaceholder")}
                  class="w-full bg-surface-low border border-outline-variant/40 text-on-surface text-sm font-mono px-4 py-3 outline-none focus:border-primary/60 transition-colors placeholder:text-outline/40"
                />
              </div>
            </div>

            <!-- Mensagem -->
            <div>
              <label for="cf-message" class="block text-xs font-mono text-outline tracking-widest uppercase mb-2">
                {t(lang, "contact.form.message")} <span class="text-primary">*</span>
              </label>
              <textarea
                id="cf-message" name="message" required rows="5"
                placeholder={t(lang, "contact.form.messagePlaceholder")}
                class="w-full bg-surface-low border border-outline-variant/40 text-on-surface text-sm font-mono px-4 py-3 outline-none focus:border-primary/60 transition-colors placeholder:text-outline/40 resize-none"
              ></textarea>
            </div>

            <!-- Submit -->
            <div class="flex items-center gap-4">
              <button
                type="submit"
                id="cf-submit"
                class="inline-flex items-center gap-3 px-6 py-3 font-medium text-sm text-on-primary hover:opacity-90 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed"
                style="background: linear-gradient(135deg, #45dfa4, #006041);"
              >
                <span id="cf-submit-label">{t(lang, "contact.form.submit")}</span>
                <span class="font-mono">→</span>
              </button>
              <p id="cf-status" class="text-sm font-mono hidden"></p>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  #typing-cursor {
    animation: blink 0.9s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* Foto: começa colapsada (nome colado à esquerda); ao revelar, "empurra"
     o texto pra direita (max-width/margin) e dá um pop (scale com overshoot). */
  #hero-photo {
    max-width: 0;
    margin-right: 0;
    opacity: 0;
    transform: scale(0);
    transition: max-width 0.55s ease-out, margin-right 0.55s ease-out, opacity 0.4s ease-out;
  }
  #hero-photo.revealed {
    max-width: 9rem;
    margin-right: 1.5rem;
    opacity: 1;
    animation: heroPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes heroPop {
    0%   { transform: scale(0); }
    60%  { transform: scale(1.12); }
    100% { transform: scale(1); }
  }

  /* Nós da timeline: vazados, preenchem quando o scroll passa por eles */
  .tl-node.filled {
    background-color: #45dfa4;
    border-color: #45dfa4;
    box-shadow: 0 0 10px 2px rgba(69, 223, 164, 0.45);
  }
</style>

<script>
  // ── Timeline scroll animation (desktop + mobile) ─────────────
  const center = (n: HTMLElement, rootTop: number) =>
    n.getBoundingClientRect().top + n.offsetHeight / 2 - rootTop;

  const wireTimeline = (root: HTMLElement) => {
    const track = root.querySelector<HTMLElement>('.tl-track');
    const fill  = root.querySelector<HTMLElement>('.tl-fill');
    const dot   = root.querySelector<HTMLElement>('.tl-dot');
    const nodes = Array.from(root.querySelectorAll<HTMLElement>('.tl-node'));
    if (!track || !fill || !dot || !nodes.length) return;

    const update = () => {
      // Ignora quando o root está oculto (ex.: layout do outro breakpoint)
      if (root.offsetParent === null) return;

      const rootRect = root.getBoundingClientRect();
      const viewH    = window.innerHeight;
      const firstY   = center(nodes[0], rootRect.top);
      const lastY    = center(nodes[nodes.length - 1], rootRect.top);
      const span     = Math.max(1, lastY - firstY);

      // Linha/fill começam no 1º nó e terminam no último
      track.style.top    = firstY + 'px';
      track.style.bottom = (rootRect.height - lastY) + 'px';
      fill.style.top     = firstY + 'px';

      const progress = Math.min(1, Math.max(0, (viewH * 0.55 - rootRect.top - firstY) / span));
      const px       = span * progress;
      const dotY     = firstY + px;
      fill.style.height = px + 'px';
      dot.style.top     = dotY + 'px';

      // Preenche cada nó assim que a bolinha passa por ele
      for (const node of nodes) {
        node.classList.toggle('filled', dotY >= center(node, rootRect.top) - 0.5);
      }
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  };

  document.querySelectorAll<HTMLElement>('.tl-root').forEach(wireTimeline);
</script>

<script>
  // ── Contact form ─────────────────────────────────────────────
  const form       = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn  = document.getElementById('cf-submit') as HTMLButtonElement | null;
  const submitLabel= document.getElementById('cf-submit-label');
  const statusEl   = document.getElementById('cf-status');
  const pageLang   = document.documentElement.lang?.startsWith('en') ? 'en' : 'pt-BR';

  const LABELS = {
    'pt-BR': { sending: 'Enviando...', success: 'Mensagem enviada! Retorno em breve.', error: 'Algo deu errado. Tente novamente.', submit: 'Enviar mensagem' },
    'en':    { sending: 'Sending...', success: "Message sent! I'll get back to you soon.", error: 'Something went wrong. Please try again.', submit: 'Send message' },
  } as const;
  const L = LABELS[pageLang as keyof typeof LABELS] ?? LABELS['pt-BR'];

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !submitLabel || !statusEl) return;

    submitBtn.disabled = true;
    submitLabel.textContent = L.sending;
    statusEl.classList.add('hidden');

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...data, lang: pageLang }),
      });

      if (res.ok) {
        form.reset();
        statusEl.textContent = L.success;
        statusEl.className = 'text-sm font-mono text-primary';
      } else {
        statusEl.textContent = L.error;
        statusEl.className = 'text-sm font-mono text-error';
      }
    } catch {
      statusEl.textContent = L.error;
      statusEl.className = 'text-sm font-mono text-error';
    } finally {
      submitBtn.disabled = false;
      submitLabel.textContent = L.submit;
    }
  });
</script>

<script>
  // ── Glow verde seguindo o cursor ─────────────────────────────
  const glow = document.getElementById("cursor-glow");
  if (glow && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let x = window.innerWidth / 2, y = window.innerHeight / 2;
    let cx = x, cy = y, raf = 0;
    const render = () => {
      // easing pra dar um "arraste" suave na sombra
      cx += (x - cx) * 0.18;
      cy += (y - cy) * 0.18;
      glow.style.transform = `translate(${cx}px, ${cy}px) translate(-50%, -50%)`;
      raf = requestAnimationFrame(render);
    };
    window.addEventListener("pointermove", (e) => {
      x = e.clientX;
      y = e.clientY;
      glow.style.opacity = "1";
      if (!raf) raf = requestAnimationFrame(render);
    });
    window.addEventListener("mouseleave", () => { glow.style.opacity = "0"; });
  }
</script>

<script>
  const firstEl  = document.getElementById("typing-first");
  const secondEl = document.getElementById("typing-second");
  const cursor   = document.getElementById("typing-cursor");

  if (firstEl && secondEl && cursor) {
    function typeWord(el: HTMLElement, word: string, delay: number, cb?: () => void) {
      let i = 0;
      setTimeout(function tick() {
        el.textContent = word.slice(0, ++i);
        if (i < word.length) setTimeout(tick, 80);
        else if (cb) setTimeout(cb, 120);
      }, delay);
    }

    // 1. Digita "Thales" na linha 1 (cursor fica na linha 1)
    typeWord(firstEl, "Thales", 400, () => {
      // 2. Move o cursor para a linha 2 e digita "Santana"
      secondEl.after(cursor);
      typeWord(secondEl, "Santana", 0, () => {
        // 3. Revela a foto depois que o nome terminou de "digitar"
        document.getElementById("hero-photo")?.classList.add("revealed");
      });
    });
  }
</script>
