---
import Footer from '../layout/Footer.astro';
import Header from '../layout/Header.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getExperiences, getSiteSettings, assetUrl } from '../../lib/directus';
import { formatPeriod, sortExperiences } from '../../lib/utils';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const [settings, experiences] = await Promise.all([
  getSiteSettings(lang).catch((e) => {
    console.error('[AboutPage] getSiteSettings failed:', e?.message ?? e);
    return null;
  }),
  getExperiences(lang).catch((e) => {
    console.error('[AboutPage] getExperiences failed:', e?.message ?? e);
    return [];
  }),
]);

const sortedExperiences = sortExperiences(experiences);
const years = new Date().getFullYear() - 2021;
const avatarUrl = assetUrl(settings?.avatar);

const stats = [
  { label: t(lang, 'about.stats.focus'), value: t(lang, 'about.stats.focusValue') },
  { label: t(lang, 'about.stats.basedIn'), value: t(lang, 'about.stats.basedInValue') },
  { label: t(lang, 'about.stats.experience'), value: `${years}+ ${t(lang, 'about.stats.experienceValue')}` },
  { label: t(lang, 'about.stats.status'), value: t(lang, 'about.stats.statusValue') },
];
---

<BaseLayout
  title="About — Portfolio"
  description="Background, experience and what I'm working on."
  lang={lang}
>
  <Header lang={lang} />

  <main class="pt-32 pb-32">
    <!-- ── INTRO ──────────────────────────────────── -->
    <section class="max-w-7xl mx-auto px-6 mb-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-start">
        <!-- Left -->
        <div>
          <p class="text-xs font-mono text-primary tracking-[0.3em] uppercase mb-4">{t(lang, 'about.eyebrow')}</p>
          <h1 class="font-display text-6xl font-bold text-on-surface mb-8 leading-tight">
            {t(lang, 'about.title1')}<br />{t(lang, 'about.title2')}
          </h1>
          <div class="text-on-surface-variant leading-relaxed space-y-4 max-w-lg">
            <p>{settings?.bio || t(lang, 'about.bioFallback')}</p>
          </div>

          {/* Social links */}
          {(settings?.github || settings?.linkedin) && (
            <div class="flex gap-6 mt-8">
              {settings?.github && (
                <a href={settings?.github} target="_blank" rel="noopener noreferrer"
                  class="text-xs font-mono text-outline hover:text-primary tracking-widest uppercase transition-colors">
                  GitHub →
                </a>
              )}
              {settings?.linkedin && (
                <a href={settings?.linkedin} target="_blank" rel="noopener noreferrer"
                  class="text-xs font-mono text-outline hover:text-primary tracking-widest uppercase transition-colors">
                  LinkedIn →
                </a>
              )}
            </div>
          )}
        </div>

        <!-- Right: profile photo + stats/info block -->
        <div class="flex flex-col items-center gap-12">
          <!-- Foto de perfil (redonda, centralizada). Fallback: avatar padrão. -->
          <div class="w-40 h-40 rounded-full overflow-hidden ring-1 ring-outline-variant/40 bg-surface-low shrink-0">
            {avatarUrl ? (
              <img
                src={avatarUrl}
                alt={settings?.name ?? 'Profile photo'}
                width="160"
                height="160"
                class="w-full h-full object-cover"
              />
            ) : (
              <svg viewBox="0 0 160 160" class="w-full h-full text-outline" aria-hidden="true">
                <rect width="160" height="160" class="fill-surface-container" />
                <circle cx="80" cy="62" r="28" fill="currentColor" />
                <path d="M28 148c0-28.7 23.3-52 52-52s52 23.3 52 52" fill="currentColor" />
              </svg>
            )}
          </div>

          <!-- Stats / info -->
          <div class="grid grid-cols-2 gap-px bg-outline-variant/20 w-full">
            {stats.map(({ label, value }) => (
              <div class="bg-surface-low p-8">
                <p class="text-xs font-mono text-outline tracking-widest uppercase mb-2">{label}</p>
                <p class="font-display text-lg font-semibold text-on-surface">{value}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── EXPERIENCE TIMELINE ────────────────────── -->
    <section class="bg-surface-low py-32">
      <div class="max-w-7xl mx-auto px-6">
        <p class="text-xs font-mono text-primary tracking-[0.3em] uppercase mb-4">{t(lang, 'about.career.eyebrow')}</p>
        <h2 class="font-display text-4xl font-bold text-on-surface mb-16">{t(lang, 'about.career.title')}</h2>

        {sortedExperiences.length > 0 ? (
          <div class="relative">
            <!-- Timeline line -->
            <div class="absolute left-0 top-0 bottom-0 w-px bg-outline-variant/40 hidden lg:block"></div>

            <div class="space-y-16">
              {sortedExperiences.map((exp) => (
                <div class="lg:pl-12 relative">
                  <!-- Timeline dot -->
                  <div class="absolute left-0 top-1.5 w-2 h-2 bg-primary hidden lg:block" style="transform: translateX(-3.5px);"></div>

                  <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
                    <!-- Period -->
                    <div class="lg:col-span-1">
                      <p class="text-xs font-mono text-outline tracking-wider">
                        {formatPeriod(exp.start_date, exp.end_date, exp.current, lang)}
                      </p>
                    </div>

                    <!-- Content -->
                    <div class="lg:col-span-3">
                      <h3 class="font-display text-xl font-semibold text-on-surface mb-1">{exp.role}</h3>
                      <p class="text-sm text-primary font-mono mb-4">{exp.company}</p>
                      {exp.description && (
                        <p class="text-on-surface-variant leading-relaxed mb-4">{exp.description}</p>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <p class="text-outline font-mono text-sm">{t(lang, 'about.career.empty')}</p>
        )}
      </div>
    </section>

    <!-- ── CONTACT ────────────────────────────────── -->
    <section class="py-32">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-xl">
          <p class="text-xs font-mono text-primary tracking-[0.3em] uppercase mb-4">{t(lang, 'nav.contact')}</p>
          <h2 class="font-display text-4xl font-bold text-on-surface mb-6">{t(lang, 'about.contact.title')}</h2>
          <p class="text-on-surface-variant mb-8">
            {t(lang, 'about.contact.body')}
          </p>
          <a
            href={`mailto:${settings?.email || 'contact@example.com'}`}
            class="inline-flex items-center gap-3 px-6 py-3 font-medium text-sm text-on-primary hover:opacity-90 transition-opacity"
            style="background: linear-gradient(135deg, #45dfa4, #006041);"
          >
            {settings?.email || 'contact@example.com'}
            <span class="font-mono">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
