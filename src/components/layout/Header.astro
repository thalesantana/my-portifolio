---
import { t, type Locale } from "../../i18n/ui";
import { localizedPath } from "../../i18n/routing";
import LangSwitcher from "./LangSwitcher.astro";

interface Props {
  lang?: Locale;
}

const { lang = "pt-BR" } = Astro.props;

const homeBase = localizedPath("/", lang);

// Na home page os links são âncoras na mesma página.
// Nas páginas de detalhe, apontam para a home + âncora.
const isDetailPage = Astro.url.pathname.includes("/projects/");

const anchor = (id: string) => isDetailPage ? `${homeBase}#${id}` : `#${id}`;

const navLinks = [
  { label: t(lang, "nav.about"),    href: anchor("sobre") },
  { label: t(lang, "nav.projects"), href: anchor("projetos") },
  { label: t(lang, "nav.contact"),  href: anchor("contato") },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-outline-variant/15 bg-surface/90 backdrop-blur-sm"
>
  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo / wordmark -->
    <a
      href={homeBase}
      class="font-display text-[10px] tracking-tight sm:text-sm sm:tracking-widest font-semibold text-primary uppercase whitespace-nowrap"
    >
      &lt;portfolio /&gt;
    </a>

    <!-- Nav -->
    <nav class="flex items-center gap-2 sm:gap-8">
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="text-[10px] sm:text-xs font-medium tracking-normal sm:tracking-wider uppercase transition-colors text-on-surface-variant hover:text-on-surface whitespace-nowrap"
        >
          {label}
        </a>
      ))}
      <LangSwitcher lang={lang} />
    </nav>
  </div>
</header>
