---
import { t, type Locale } from "../../i18n/ui";
import { localizedPath } from "../../i18n/routing";
import LangSwitcher from "./LangSwitcher.astro";

interface Props {
  lang?: Locale;
}

const { lang = "pt-BR" } = Astro.props;

const navLinks = [
  { label: t(lang, "nav.projects"), path: "/projects" },
  { label: t(lang, "nav.about"), path: "/about" },
];

const homeHref = localizedPath("/", lang);
const currentPath = Astro.url.pathname;
---

<header
  class="fixed top-0 left-0 right-0 z-50 border-b border-outline-variant/15 bg-surface/90 backdrop-blur-sm"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo / wordmark -->
    <a
      href={homeHref}
      class="font-display text-sm font-semibold tracking-widest text-primary uppercase"
    >
      &lt;portfolio /&gt;
    </a>

    <!-- Nav -->
    <nav class="flex items-center gap-8">
      {
        navLinks.map(({ label, path }) => {
          const href = localizedPath(path, lang);
          return (
            <a
              href={href}
              class={[
                "text-xs font-medium tracking-wider uppercase transition-colors",
                currentPath === href || currentPath.startsWith(href + "/")
                  ? "text-primary"
                  : "text-on-surface-variant hover:text-on-surface",
              ].join(" ")}
            >
              {label}
            </a>
          );
        })
      }
      <LangSwitcher lang={lang} />
    </nav>
  </div>
</header>
