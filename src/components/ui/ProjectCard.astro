---
import type { Project } from "../../lib/directus";
import { assetUrl } from "../../lib/directus";
import { t, type Locale } from "../../i18n/ui";
import { localizedPath } from "../../i18n/routing";
import TechChip from "./TechChip.astro";

interface Props {
  project: Project;
  lang?: Locale;
}

const { project, lang = "pt-BR" } = Astro.props;
const thumbnail = assetUrl(project.cover_image);
const year = project.start_date
  ? new Date(project.start_date).getUTCFullYear()
  : null;
const href = localizedPath(`/projects/${project.slug}`, lang);
---

<a
  href={href}
  class="group block bg-surface-low hover:bg-surface-container transition-colors"
>
  <!-- Thumbnail -->
  <div class="aspect-video bg-surface-lowest overflow-hidden relative">
    {
      thumbnail ? (
        <img
          src={thumbnail}
          alt={project.title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <span class="text-xs font-mono text-outline-variant tracking-widest uppercase">
            {t(lang, "projects.card.noPreview")}
          </span>
        </div>
      )
    }
    {project.hackathon_winner && (
      <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-mono font-semibold tracking-widest uppercase rounded-full bg-[#FFD700]/15 text-[#FFD700] border border-[#FFD700]/30">
        ★ {t(lang, "personal.winner")}
      </span>
    )}
  </div>

  <!-- Content -->
  <div class="p-6">
    {
      year && (
        <p class="text-xs font-mono text-primary tracking-widest uppercase mb-2">
          {year}
        </p>
      )
    }
    <h3
      class="font-display text-lg font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors"
    >
      {project.title}
    </h3>
    <p class="text-sm text-on-surface-variant mb-4 line-clamp-2">
      {project.description}
    </p>
    <div class="flex flex-wrap gap-2">
      {project.tech_stack?.slice(0, 4).map((tech) => <TechChip label={tech} />)}
    </div>
  </div>
</a>
