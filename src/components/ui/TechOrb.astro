---
// Órbita de tecnologias animada (núcleo "respirando" + chips flutuando).
// `class` controla o tamanho (ex.: "w-[24rem] h-[24rem]" no desktop,
// "w-72 h-72" como fundo no mobile).
interface Props {
  class?: string;
}
const { class: cls = "w-[24rem] h-[24rem]" } = Astro.props;

// Logos das techs (SVGs inline)
const ICONS: Record<string, string> = {
  React: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="2" fill="#61DAFB"/><g stroke="#61DAFB" stroke-width="1"><ellipse cx="12" cy="12" rx="10" ry="4.5"/><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4.5" transform="rotate(120 12 12)"/></g></svg>`,
  "Node.js": `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 1.8 2.9 7v10L12 22.2 21.1 17V7z" fill="#539E43"/><text x="12" y="15.5" font-size="7" font-family="monospace" font-weight="700" fill="#fff" text-anchor="middle">JS</text></svg>`,
  Web3: `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 2 5 12l7 4 7-4z" fill="#627EEA"/><path d="M12 22 5 13l7 4 7-4z" fill="#627EEA" opacity=".6"/></svg>`,
  Cloud: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#FF9900" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 19a4.5 4.5 0 0 0 0-9 6 6 0 0 0-11.6 1.5A3.5 3.5 0 0 0 6 19z"/></svg>`,
  TypeScript: `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect width="24" height="24" rx="3" fill="#3178C6"/><text x="12" y="17" font-size="11" font-family="monospace" font-weight="700" fill="#fff" text-anchor="middle">TS</text></svg>`,
  AI: `<svg viewBox="0 0 24 24" width="18" height="18" fill="#1f9d6b" aria-hidden="true"><path d="M12 2l1.7 4.3L18 8l-4.3 1.7L12 14l-1.7-4.3L6 8l4.3-1.7z"/><path d="M18.5 14l.9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9z"/></svg>`,
};

const techChips = [
  { label: "React",      pos: "top-[4%]  left-[10%]",  delay: "0s",   dur: "6s"   },
  { label: "Node.js",    pos: "top-[12%] right-[2%]",  delay: "1.2s", dur: "7s"   },
  { label: "Web3",       pos: "top-[44%] right-[-4%]", delay: "0.6s", dur: "6.5s" },
  { label: "Cloud",        pos: "bottom-[8%] right-[10%]", delay: "1.8s", dur: "7.5s" },
  { label: "TypeScript", pos: "bottom-[16%] left-[-2%]", delay: "0.9s", dur: "6.2s" },
  { label: "AI",         pos: "top-[40%] left-[-2%]",  delay: "1.5s", dur: "7.2s" },
];
---

<div class:list={["relative max-w-full", cls]}>
  <!-- Glow de fundo -->
  <div
    class="absolute inset-4 rounded-full blur-3xl opacity-40 hero-breathe"
    style="background: radial-gradient(circle, #45dfa4, transparent 70%);"
  >
  </div>

  <!-- Lente: distorce o grid atrás (borda difuminada, sem anel sólido) -->
  <div
    class="absolute inset-6 rounded-full hero-breathe"
    style="backdrop-filter: blur(7px) saturate(150%); -webkit-backdrop-filter: blur(7px) saturate(150%); background: radial-gradient(circle at 35% 30%, rgba(69,223,164,0.16), rgba(69,223,164,0.03) 55%, transparent 72%); -webkit-mask: radial-gradient(circle, #000 50%, transparent 75%); mask: radial-gradient(circle, #000 50%, transparent 75%);"
  >
  </div>

  <!-- Núcleo pulsante (esfera com volume) -->
  <div
    class="absolute inset-12 rounded-full flex items-center justify-center hero-breathe"
    style="background: radial-gradient(circle at 32% 28%, #5bf0b6, #006041); box-shadow: 0 0 90px 10px rgba(69,223,164,0.45), inset -14px -14px 44px rgba(0,40,25,0.6), inset 12px 12px 32px rgba(150,255,215,0.4);"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="76" height="76" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="filter: drop-shadow(0 2px 6px rgba(0,0,0,0.35));">
      <path d="m8 8-4 4 4 4" /><path d="m16 8 4 4-4 4" /><path d="M14 5 10 19" />
    </svg>
  </div>

  <!-- Chips flutuantes -->
  {techChips.map((chip) => (
    <div
      class={`hero-chip absolute ${chip.pos} inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-2 shadow-[0_6px_24px_rgba(0,0,0,0.35)]`}
      style={`--delay:${chip.delay}; --dur:${chip.dur};`}
    >
      <span class="shrink-0 flex items-center" set:html={ICONS[chip.label]} />
      <span class="text-sm font-mono font-medium text-[#0f1a2a] whitespace-nowrap">{chip.label}</span>
    </div>
  ))}
</div>

<style>
  @keyframes hero-breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.06); }
  }
  .hero-breathe { animation: hero-breathe 6s ease-in-out infinite; }

  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10px); }
  }
  .hero-chip {
    animation: hero-float var(--dur, 6s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-breathe, .hero-chip { animation: none; }
  }
</style>
